							<PHYSICAL-DIMENSION ID="PD-rad">
								<SHORT-NAME>rad</SHORT-NAME>
							</PHYSICAL-DIMENSION>
							<!-- Angular Velocity -->
							<PHYSICAL-DIMENSION ID="PD-rad_s">
								<SHORT-NAME>rad_s</SHORT-NAME>
								<TIME-EXP>-1</TIME-EXP>
							</PHYSICAL-DIMENSION>
