							<PHYSICAL-DIMENSION ID="PD-C">
								<SHORT-NAME>C</SHORT-NAME>
								<TIME-EXP>1</TIME-EXP>
								<CURRENT-EXP>1</CURRENT-EXP>
							</PHYSICAL-DIMENSION>
							<!-- Curvature -->
							<PHYSICAL-DIMENSION ID="PD-per_m">
								<SHORT-NAME>per_m</SHORT-NAME>
