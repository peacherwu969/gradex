								<LENGTH-EXP>2</LENGTH-EXP>
								<MASS-EXP>1</MASS-EXP>
								<TIME-EXP>-3</TIME-EXP>
							</PHYSICAL-DIMENSION>
							<!-- Pressure -->
							<PHYSICAL-DIMENSION ID="PD-Pa">
								<SHORT-NAME>Pa</SHORT-NAME>
								<LENGTH-EXP>-1</LENGTH-EXP>
								<MASS-EXP>1</MASS-EXP>
								<TIME-EXP>-2</TIME-EXP>
							</PHYSICAL-DIMENSION>
							<!-- Resistance -->
							<PHYSICAL-DIMENSION ID="PD-R">
								<SHORT-NAME>R</SHORT-NAME>
								<LENGTH-EXP>2</LENGTH-EXP>
								<MASS-EXP>1</MASS-EXP>
								<TIME-EXP>-3</TIME-EXP>
								<CURRENT-EXP>-2</CURRENT-EXP>
							</PHYSICAL-DIMENSION>
							<!-- SolidAngle -->
							<PHYSICAL-DIMENSION ID="PD-sr">
								<SHORT-NAME>sr</SHORT-NAME>
							</PHYSICAL-DIMENSION>
							<!-- Strings -->
							<PHYSICAL-DIMENSION ID="PD-STRING">
								<SHORT-NAME>STRING</SHORT-NAME>
							</PHYSICAL-DIMENSION>
							<!-- Substance -->
							<PHYSICAL-DIMENSION ID="PD-mol">
								<SHORT-NAME>mol</SHORT-NAME>
								<MOLAR-AMOUNT-EXP>1</MOLAR-AMOUNT-EXP>
							</PHYSICAL-DIMENSION>
							<!-- Temperature -->
							<PHYSICAL-DIMENSION ID="PD-K">
								<SHORT-NAME>K</SHORT-NAME>
								<TEMPERATURE-EXP>1</TEMPERATURE-EXP>
							</PHYSICAL-DIMENSION>
							<!-- ThrashingPerformance -->
							<PHYSICAL-DIMENSION ID="PD-ha_h">
								<SHORT-NAME>ha_h</SHORT-NAME>
								<LENGTH-EXP>2</LENGTH-EXP>
								<TIME-EXP>-1</TIME-EXP>
							</PHYSICAL-DIMENSION>
							<!-- Time -->
							<PHYSICAL-DIMENSION ID="PD-s">
								<SHORT-NAME>s</SHORT-NAME>
								<TIME-EXP>1</TIME-EXP>
							</PHYSICAL-DIMENSION>
							<!-- Torque -->
							<PHYSICAL-DIMENSION ID="PD-Nm">
								<SHORT-NAME>Nm</SHORT-NAME>
								<LENGTH-EXP>2</LENGTH-EXP>
								<MASS-EXP>1</MASS-EXP>
								<TIME-EXP>-2</TIME-EXP>
							</PHYSICAL-DIMENSION>
							<!-- Velocity -->
							<PHYSICAL-DIMENSION ID="PD-m_s">
								<SHORT-NAME>m_s</SHORT-NAME>
