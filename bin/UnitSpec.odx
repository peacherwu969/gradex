								<MASS-EXP>1</MASS-EXP>
								<TIME-EXP>-1</TIME-EXP>
							</PHYSICAL-DIMENSION>
							<!-- MomentOfInertia -->
							<PHYSICAL-DIMENSION ID="PD-Nms_squared">
