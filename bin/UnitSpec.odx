								<MASS-EXP>1</MASS-EXP>
								<TIME-EXP>-2</TIME-EXP>
								<CURRENT-EXP>-2</CURRENT-EXP>
							</PHYSICAL-DIMENSION>
							<!-- Length -->
							<PHYSICAL-DIMENSION ID="PD-m">
								<SHORT-NAME>m</SHORT-NAME>
								<LENGTH-EXP>1</LENGTH-EXP>
							</PHYSICAL-DIMENSION>
							<!-- Luminosity -->
							<PHYSICAL-DIMENSION ID="PD-cd">
