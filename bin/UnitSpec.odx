							</UNIT>
							<UNIT ID="Velocity-mm_s">
								<SHORT-NAME>mm_s</SHORT-NAME>
								<LONG-NAME>velocity : millimetre per second</LONG-NAME>
								<DISPLAY-NAME>mm/s</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>1000.0</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
