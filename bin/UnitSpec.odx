						<UNITS>
							<UNIT ID="Acceleration-m_s_squared">
								<SHORT-NAME>m_s_squared</SHORT-NAME>
								<LONG-NAME>acceleration : metre per second squared</LONG-NAME>
								<DISPLAY-NAME>m/s&#178;</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>1.0</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-m_s_squared"/>
							</UNIT>
							<UNIT ID="Angle-rad">
								<SHORT-NAME>rad</SHORT-NAME>
								<LONG-NAME>plane angle : radian</LONG-NAME>
								<DISPLAY-NAME>rad</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>1.0</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-rad"/>
							</UNIT>
							<UNIT ID="Angle-mrad">
								<SHORT-NAME>mrad</SHORT-NAME>
								<LONG-NAME>plane angle : milliRadian</LONG-NAME>
								<DISPLAY-NAME>mrad</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>1000.0</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-rad"/>
							</UNIT>
							<UNIT ID="Angle-deg">
								<SHORT-NAME>deg</SHORT-NAME>
								<LONG-NAME>plane angle : degree</LONG-NAME>
								<DISPLAY-NAME>&#176;</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>57.295776</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-rad"/>
							</UNIT>
							<UNIT ID="AngularMomentum-Nms">
								<SHORT-NAME>Nms</SHORT-NAME>
								<LONG-NAME>angular momentum : newton metre second</LONG-NAME>
								<DISPLAY-NAME>Nms</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>1.0</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-Nms"/>
							</UNIT>
							<UNIT ID="AngularVelocity-rad_s">
								<SHORT-NAME>rad_s</SHORT-NAME>
								<LONG-NAME>angular velocity : radian per second</LONG-NAME>
								<DISPLAY-NAME>rad/s</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>1.0</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-rad_s"/>
							</UNIT>
							<UNIT ID="AngularVelocity-deg_s">
								<SHORT-NAME>deg_s</SHORT-NAME>
								<LONG-NAME>angular velocity : degree per second</LONG-NAME>
								<DISPLAY-NAME>&#176;/s</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>57.295776</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-rad_s"/>
							</UNIT>
							<UNIT ID="Area-m_squared">
								<SHORT-NAME>m_squared</SHORT-NAME>
								<LONG-NAME>area : square metre</LONG-NAME>
								<DISPLAY-NAME>m&#178;</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>1.0</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-m_squared"/>
							</UNIT>
							<UNIT ID="Area-ha">
								<SHORT-NAME>ha</SHORT-NAME>
								<LONG-NAME>area : hectare</LONG-NAME>
								<DISPLAY-NAME>ha</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>0.0001</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-m_squared"/>
							</UNIT>
							<UNIT ID="Capacitance-F">
								<SHORT-NAME>F</SHORT-NAME>
								<LONG-NAME>capacitance : farad</LONG-NAME>
								<DISPLAY-NAME>F</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>1.0</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-F"/>
							</UNIT>
							<UNIT ID="Capacitance-pF">
								<SHORT-NAME>pF</SHORT-NAME>
								<LONG-NAME>capacitance : picofarad</LONG-NAME>
								<DISPLAY-NAME>pF</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>1.0E12</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-F"/>
							</UNIT>
							<UNIT ID="Capacitance-nF">
								<SHORT-NAME>nF</SHORT-NAME>
								<LONG-NAME>capacitance : nanofarad</LONG-NAME>
								<DISPLAY-NAME>nF</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>1.0E9</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-F"/>
							</UNIT>
							<UNIT ID="Capacitance-uF">
								<SHORT-NAME>uF</SHORT-NAME>
								<LONG-NAME>capacitance : microfarad</LONG-NAME>
								<DISPLAY-NAME>&#181;F</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>1000000.0</FACTOR-SI-TO-UNIT>
								<OFFSET-SI-TO-UNIT>0.0</OFFSET-SI-TO-UNIT>
								<PHYSICAL-DIMENSION-REF ID-REF="PD-F"/>
							</UNIT>
							<UNIT ID="Charge-C">
								<SHORT-NAME>C</SHORT-NAME>
								<LONG-NAME>electric charge : coulomb</LONG-NAME>
								<DISPLAY-NAME>C</DISPLAY-NAME>
								<FACTOR-SI-TO-UNIT>1.0</FACTOR-SI-TO-UNIT>
