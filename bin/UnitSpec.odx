								<LENGTH-EXP>3</LENGTH-EXP>
								<TIME-EXP>-1</TIME-EXP>
							</PHYSICAL-DIMENSION>
							<!-- Energy -->
							<PHYSICAL-DIMENSION ID="PD-J">
